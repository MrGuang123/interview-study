{
  "meta": {
    "name": "Interview Forge UI",
    "version": "0.1.0",
    "updatedAt": "2026-10-22",
    "status": "design-specification",
    "source": "User-approved light and dark gradient direction; UI-design contains concept illustrations, not pixel-exact specifications.",
    "units": {
      "dimension": "pixel-equivalent number; Web may convert scalable values to rem using 16 px per rem; native platforms must map to their logical units",
      "fontSize": "pixel-equivalent number; respect platform text scaling",
      "lineHeight": "unitless multiplier",
      "fontWeight": "numeric font weight",
      "letterSpacing": "em",
      "duration": "millisecond",
      "angle": "degree clockwise from upward",
      "opacity": "0 to 1",
      "position": "0 to 1 along the gradient",
      "radialCenter": "x and y fractions of the painted area",
      "radialRadius": "fraction of the longer edge of the painted area",
      "cubicBezier": "four unitless coordinates",
      "breakpoint": "minimum CSS viewport width in px for Web; other clients choose layout by available space",
      "zIndex": "unitless relative stacking order",
      "scale": "unitless multiplier",
      "viewportRatio": "fraction of the currently available viewport dimension"
    },
    "references": {
      "syntax": "An object with only $ref is an alias using an absolute JSON Pointer into this document. Resolve recursively before output; unresolved or cyclic aliases are errors.",
      "modes": "colors, gradient and shadow contain explicit light and dark values; select one mode before mapping to a platform.",
      "compatibility": "colors.light/dark values remain hex strings; fontSize, radius, spacing and duration remain flat numeric maps for the introductory Web generator.",
      "semanticPaths": "components fields ending in -fill, -text, -color, plus fill/boundary-color/ring-color may contain semantic path strings with <mode>; these are binding instructions, not $ref aliases. Replace <mode> with light or dark in the platform adapter."
    },
    "usage": {
      "gradient": "Primary gradients are for main actions and compact feature accents. Ambient gradients are low-opacity page decoration behind panels. Reading, editor, table, input and chat content surfaces remain solid. Use sRGB interpolation in platform output to preserve the checked contrast ratios.",
      "colorPairing": "Use foreground on background/surface; muted-foreground on background/surface; muted-surface-foreground on surface-muted/hover. Use selection-foreground on selection. Use success/warning/danger/info on the matching status surface.",
      "border": "border is decorative separation; form field boundaries and controls requiring visible outlines use border-control.",
      "charts": "Give series a label, marker or dash pattern as well as color.",
      "density": "Compact visual controls require an enclosing interaction target of at least size.touch-target. Numeric heights are minimums unless the component explicitly describes a viewport area.",
      "safeArea": "Mobile top/bottom insets are runtime platform values and must be added to shell spacing; no fixed safe-area number is assumed."
    }
  },
